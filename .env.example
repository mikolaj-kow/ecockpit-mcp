# ecockpit-mcp configuration - ONE file for all three parts
# (MCP server, in-instance command relay, executor). Copy to .env
# (gitignored) and edit.

# --- automation project ----------------------------------------------------
# Repo/checkout of YOUR PLC automation project. Holds the plcopensrc/ XML
# source tree (Application.*.xml); .ecp auto-discovery and the default
# snapshots dir also start here. No default is built in on purpose.
ECP_PROJECT_ROOT=C:\path\to\your\automation-project

# XML source dir override (default: auto-discover
# <ECP_PROJECT_ROOT>/plcopensrc or plcopensrc/<device>/)
#ECP_XML_DIR=

# Snapshot destination (default: <ECP_PROJECT_ROOT>\snapshots) and the
# fallback search root for the open .ecp when it lives outside the project
# repo (default: ECP_PROJECT_ROOT)
#ECP_SNAPSHOTS_DIR=
#ECP_PROJECTS_DIR=

# POU whose source XML carries the version variable sAppVersion (string
# constant initializer) - used to name snapshots; empty = dotted number
# from the project filename only
#ECP_VERSION_POU=

# POUs/DUTs removed from the project: on import, stale project objects of
# these names are deleted (comma/space separated)
#REMOVED_POUS=

# File-protocol work dir for the command/result/heartbeat files and logs
# (default: tmp\ next to the scripts - same for all three parts)
#ECP_WORK_DIR=

# --- MCP server bind -------------------------------------------------------
ECP_MCP_HOST=127.0.0.1
ECP_MCP_PORT=9777

# Bearer token - REQUIRED for non-loopback binds (0.0.0.0 etc.).
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ECP_MCP_TOKEN=

# --- PLC login (online commands: ecockpit_read / ecockpit_download) --------
# No built-in default on purpose: without credentials those commands fail
# with an instruction instead of guessing.
PLC_USER=
PLC_PASS=

# Compiler codes excluded from the build/compile harvest (comma-separated),
# e.g. known-noise warnings. Bypass for one run with all_messages=true.
#IGNORE_CODES=

# --- PLC status probe --------------------------------------------------------
# TCP port ecockpit_server_status probes for live PLC reachability (host-side
# socket connect to the IP the executor last recorded; never touches the
# engine). Default: 2455 (CODESYS V3 runtime).
#ECP_PLC_PROBE_PORT=2455
